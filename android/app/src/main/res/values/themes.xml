<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- DayNight：跟随系统深浅色，网页的 prefers-color-scheme 也会跟着变 -->
    <style name="Theme.Jiaozi" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/page_bg</item>
        <item name="android:statusBarColor">@color/page_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
