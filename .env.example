# 复制为 .env 后填写
# 用户没选过模型时默认用哪个（页面右上角可以切换）
DEEPSEEK_MODEL=deepseek-flash

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=chatbot

# 登录 session 签名密钥，填一个随机长字符串，可用下面命令生成：
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# 部署到 HTTPS 后改为 1（本地用 http 测试时保持 0，否则无法登录）
SESSION_COOKIE_SECURE=0

PORT=5000

# ---- 以下可选，不填就用默认值 ----
# 用户打开"连续对话"时带上最近几轮（一问一答算一轮）
# CONTEXT_ROUNDS=3
# 可切换的模型和各自的价格写在 app.py 顶部的 MODELS 里，DeepSeek 调价或出新模型时改那里
