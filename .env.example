# 复制为 .env 后填写
DEEPSEEK_MODEL=deepseek-flash

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=chatbot

# 登录 session 签名密钥，填一个随机长字符串，可用下面命令生成：
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# 部署到 HTTPS 后改为 1（本地用 http 测试时保持 0，否则无法登录）
SESSION_COOKIE_SECURE=0

PORT=5000
